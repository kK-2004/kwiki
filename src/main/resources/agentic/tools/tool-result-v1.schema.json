{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "callId",
    "status",
    "evidenceRefs",
    "degradations",
    "errorCode",
    "stats"
  ],
  "properties": {
    "callId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "SUCCESS",
        "ERROR"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "degradations": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentCount": {
          "type": "integer",
          "minimum": 0
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    }
  }
}
