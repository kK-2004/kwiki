<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="redactedMsg"
                    class="com.kwiki.infrastructure.observability.SecretRedactingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [traceId=%X{traceId:-} spanId=%X{spanId:-} thread=%thread] %logger{36} - %redactedMsg%n%ex{5}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
