# kwiki external service configuration template (secret-free).
# Copy to .env (git-ignored) and fill in operator-provided values.
# kwiki never provisions middleware containers; these point at existing services.

# --- Application security (generate a random >=32 char value, e.g. openssl rand -base64 32) ---
KWIKI_JWT_SECRET=
KWIKI_JWT_TTL=12h

# --- kk-common SDK feature switches (see docs/kk-common-integration.md) ---
# Web request-context and the shared exception handler default on. Redis and
# Redisson are now formal runtime dependencies and also default ON: provide
# KWIKI_REDIS_* below (no implicit localhost fallback — startup/readiness
# fails when Redis is unreachable). Only an approved isolated environment
# should explicitly disable them; features that require a distributed lock
# then fail closed.
KK_COMMON_WEB_ENABLED=true
KK_COMMON_EXCEPTION_ENABLED=true
KK_COMMON_REDIS_ENABLED=true
KK_COMMON_REDISSON_ENABLED=true

# --- Time handling ---
# Display time zone for timestamps in JSON responses (stored as UTC internally).
# Defaults to Asia/Shanghai.
KWIKI_TIME_DISPLAY_ZONE=Asia/Shanghai

# --- MySQL (operator-provided) ---
KWIKI_MYSQL_URL='jdbc:mysql://mysql.example.internal:3306/kwiki?serverTimezone=UTC&allowPublicKeyRetrieval=true'
KWIKI_MYSQL_USERNAME=
KWIKI_MYSQL_PASSWORD=

# --- Redis (operator-provided) ---
KWIKI_REDIS_HOST=redis.example.internal
KWIKI_REDIS_PORT=6379
KWIKI_REDIS_PASSWORD=
KWIKI_REDIS_DATABASE=0

# --- Content center / k-File (operator-provided; the app token authenticates
# --- attachment upload/download open-API calls; source/path are optional routing hints)
KWIKI_CONTENT_CENTER_BASE_URL=https://content-center.example.internal
KWIKI_CONTENT_CENTER_APP_TOKEN=
KWIKI_CONTENT_CENTER_SOURCE=
KWIKI_CONTENT_CENTER_PATH=
KWIKI_CONTENT_CENTER_CONNECT_TIMEOUT=10s
KWIKI_CONTENT_CENTER_REQUEST_TIMEOUT=600s

# --- Elasticsearch (operator-provided; basic auth OR API key, pick one) ---
KWIKI_ELASTICSEARCH_URIS=https://es.example.internal:9200
KWIKI_ELASTICSEARCH_USERNAME=
KWIKI_ELASTICSEARCH_PASSWORD=
KWIKI_ELASTICSEARCH_API_KEY=

# --- Answer LLM (OpenAI-compatible endpoint, kwiki-specific credential) ---
KWIKI_ANSWER_LLM_BASE_URL=https://llm.example.internal/v1
KWIKI_ANSWER_LLM_API_KEY=
KWIKI_ANSWER_LLM_MODEL=
KWIKI_ANSWER_LLM_TIMEOUT=120s
# 启动时从 provider 的 /models API 自动探测模型最大输出额度

# Agentic 查询全流程结构化日志（TRACE/DEBUG/INFO/WARN/OFF）
KWIKI_AGENTIC_LOG_LEVEL=DEBUG

# --- Qwen Embedding (MUST be a fresh kwiki credential, never copied from k-Rag) ---
KWIKI_QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KWIKI_QWEN_EMBEDDING_API_KEY=
KWIKI_QWEN_EMBEDDING_MODEL=text-embedding-v4
KWIKI_QWEN_EMBEDDING_DIMENSIONS=1024
KWIKI_QWEN_EMBEDDING_TIMEOUT=30s

# --- Multimodal document indexing (PDF embedded images + published Markdown images) ---
# Master switch. Disabled by default; when enabled, KWIKI_VISION_* must be provided.
KWIKI_MULTIMODAL_ENABLED=false
# Summary prompt identity; changing it requires an index rebuild to take effect.
KWIKI_MULTIMODAL_PROMPT_VERSION=v1
# Hard resource boundaries (fail the indexing job, never silently truncate).
KWIKI_MULTIMODAL_MAX_IMAGES_PER_DOCUMENT=20
KWIKI_MULTIMODAL_MIN_IMAGE_PIXELS=1024
KWIKI_MULTIMODAL_MAX_IMAGE_PIXELS=4194304
KWIKI_MULTIMODAL_MAX_IMAGE_BYTES=10485760
KWIKI_MULTIMODAL_MAX_SUMMARY_CHARS=512
KWIKI_MULTIMODAL_MAX_EXTERNAL_IMAGE_BYTES=10485760
KWIKI_MULTIMODAL_EXTERNAL_IMAGE_TIMEOUT=20s
KWIKI_MULTIMODAL_EXTERNAL_IMAGE_MAX_REDIRECTS=3
# Comma-separated allowlist of external image HTTPS ports (default: standard 443 only).
KWIKI_MULTIMODAL_EXTERNAL_IMAGE_ALLOWED_PORTS=443

# --- Vision summarization model (OpenAI-compatible /chat/completions; separate
# --- credential lifecycle from the answer LLM and embedding model) ---
KWIKI_VISION_BASE_URL=
KWIKI_VISION_API_KEY=
KWIKI_VISION_MODEL=qwen3.7-flash
KWIKI_VISION_CONNECT_TIMEOUT=5s
KWIKI_VISION_TIMEOUT=60s
KWIKI_VISION_MAX_RETRIES=2
KWIKI_VISION_CONCURRENCY=4

# --- Indexing worker and initial Elasticsearch index bootstrap ---
KWIKI_INDEXING_WORKER_ENABLED=true
KWIKI_INDEXING_WORKER_BATCH_SIZE=20
KWIKI_INDEXING_WORKER_POLL_INTERVAL=5s
KWIKI_INDEXING_WORKER_INITIAL_DELAY=10s
KWIKI_INDEXING_BOOTSTRAP_ENABLED=true
KWIKI_INDEX_VERSION=1

# --- Search index version management (rebuild limits / capacity / admin mutations) ---
KWIKI_INDEX_REBUILD_BATCH_SIZE=50
KWIKI_INDEX_REBUILD_MAX_CONCURRENT_RUNS=2
KWIKI_INDEX_REBUILD_EMBEDDING_QPS=20
KWIKI_INDEX_CATCHUP_BATCH_SIZE=100
KWIKI_INDEX_CATCHUP_SCAN_INTERVAL=30s
KWIKI_INDEX_CAPACITY_MIN_STORAGE_HEADROOM_PERCENT=20
KWIKI_INDEX_CAPACITY_MAX_MANAGED_INDICES=8
KWIKI_INDEX_CAPACITY_HEALTH_TIMEOUT=5s
# 发布初期保持 false（管理端只读观察）；确认就绪后显式置 true
KWIKI_INDEX_MANAGEMENT_MUTATIONS_ENABLED=false
