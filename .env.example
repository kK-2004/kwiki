# kwiki external service configuration template (secret-free).
# Copy to .env (git-ignored) and fill in operator-provided values.
# kwiki never provisions middleware containers; these point at existing services.

# --- Application security (generate a random >=32 char value, e.g. openssl rand -base64 32) ---
KWIKI_JWT_SECRET=
KWIKI_JWT_TTL=12h

# --- kk-common SDK feature switches (see docs/kk-common-integration.md) ---
# Web request-context and the shared exception handler default on; the Redis
# toolkit and the Redisson lock factory are opt-in and stay fully disconnected
# until explicitly enabled. Enabling either requires KWIKI_REDIS_* below.
KK_COMMON_WEB_ENABLED=true
KK_COMMON_EXCEPTION_ENABLED=true
KK_COMMON_REDIS_ENABLED=false
KK_COMMON_REDISSON_ENABLED=false

# --- Time handling ---
# Display time zone for timestamps in JSON responses (stored as UTC internally).
# Defaults to Asia/Shanghai.
KWIKI_TIME_DISPLAY_ZONE=Asia/Shanghai

# --- MySQL (operator-provided) ---
KWIKI_MYSQL_URL='jdbc:mysql://mysql.example.internal:3306/kwiki?serverTimezone=UTC&allowPublicKeyRetrieval=true'
KWIKI_MYSQL_USERNAME=
KWIKI_MYSQL_PASSWORD=

# --- Redis (operator-provided) ---
KWIKI_REDIS_HOST=redis.example.internal
KWIKI_REDIS_PORT=6379
KWIKI_REDIS_PASSWORD=
KWIKI_REDIS_DATABASE=0

# --- Content center / k-File (operator-provided; the app token authenticates
# --- attachment upload/download open-API calls; source/path are optional routing hints)
KWIKI_CONTENT_CENTER_BASE_URL=https://content-center.example.internal
KWIKI_CONTENT_CENTER_APP_TOKEN=
KWIKI_CONTENT_CENTER_SOURCE=
KWIKI_CONTENT_CENTER_PATH=
KWIKI_CONTENT_CENTER_CONNECT_TIMEOUT=10s
KWIKI_CONTENT_CENTER_REQUEST_TIMEOUT=600s

# --- Elasticsearch (operator-provided; basic auth OR API key, pick one) ---
KWIKI_ELASTICSEARCH_URIS=https://es.example.internal:9200
KWIKI_ELASTICSEARCH_USERNAME=
KWIKI_ELASTICSEARCH_PASSWORD=
KWIKI_ELASTICSEARCH_API_KEY=

# --- Answer LLM (OpenAI-compatible endpoint, kwiki-specific credential) ---
KWIKI_ANSWER_LLM_BASE_URL=https://llm.example.internal/v1
KWIKI_ANSWER_LLM_API_KEY=
KWIKI_ANSWER_LLM_MODEL=
KWIKI_ANSWER_LLM_TIMEOUT=120s

# --- Qwen Embedding (MUST be a fresh kwiki credential, never copied from k-Rag) ---
KWIKI_QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KWIKI_QWEN_EMBEDDING_API_KEY=
KWIKI_QWEN_EMBEDDING_DIMENSIONS=1024
KWIKI_QWEN_EMBEDDING_TIMEOUT=30s
